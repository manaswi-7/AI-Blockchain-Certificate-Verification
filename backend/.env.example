# Local development defaults
DB_URL=jdbc:postgresql://localhost:5432/certificate_db
DB_USERNAME=certificate_user
DB_PASSWORD=certificate_password
JWT_SECRET=replace-with-a-long-random-secret
SETUP_KEY=replace-with-a-random-one-time-setup-key
AI_SERVICE_URL=http://localhost:8000
VERIFICATION_URL=http://localhost:3000/verify

# Blockchain: use either local Hardhat or Polygon Amoy
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=replace-with-local-hardhat-private-key
BLOCKCHAIN_CONTRACT_ADDRESS=replace-after-deployment
BLOCKCHAIN_CHAIN_ID=31337

# Polygon Amoy example:
# BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# BLOCKCHAIN_CHAIN_ID=80002
