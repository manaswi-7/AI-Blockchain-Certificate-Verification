# Polygon Amoy deployment
# Use a current RPC provider (for example Alchemy/Infura); Polygon's old public Amoy RPC was deprecated in July 2026.
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DEPLOYER_PRIVATE_KEY=YOUR_TESTNET_WALLET_PRIVATE_KEY

# After deployment, put the contract address into Vercel:
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
