# Vercel / production blockchain verification
# Use a current Polygon Amoy RPC provider. Polygon's old public Amoy RPC was deprecated in July 2026.
BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BLOCKCHAIN_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CERTIFICATE_REGISTRY

# Local development only (if using the Spring Boot API instead of the Vercel-native route)
NEXT_PUBLIC_API_URL=http://localhost:8080/api
